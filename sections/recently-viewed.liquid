<div class="recently-viewed-section-wrapper color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <h2 class="h2">{{ section.settings.heading | escape }}</h2>
    
    <div id="recently-viewed-grid-{{ section.id }}" class="grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down">
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const LOCAL_STORAGE_KEY = 'recently_viewed';
    let recentlyViewed = JSON.parse(localStorage.getItem(LOCAL_STORAGE_KEY)) || [];
    
    // Dynamic setting for how many products to store/show
    const limit = {{ section.settings.products_to_show }};
    
    // FIX 2: Define the current product handle safely so it doesn't cause syntax errors on non-product pages
    const currentHandle = {% if template.name == 'product' %}{{ product.handle | json }}{% else %}null{% endif %};

    // 1. If we are on a product page, add the current product to the array
    {% if template.name == 'product' %}
      // FIX 1: Swapped manual quotes for the Liquid `| json` filter to prevent syntax errors
      const currentProduct = {
        handle: {{ product.handle | json }},
        title: {{ product.title | json }},
        url: {{ product.url | json }},
        price: {{ product.price | money | json }},
        image: {% if product.featured_image %}{{ product.featured_image | image_url: width: 400 | json }}{% else %}{{ 'placeholder-product.jpg' | asset_url | json }}{% endif %}
      };
      
      // Remove duplicates and respect the dynamic limit
      recentlyViewed = recentlyViewed.filter(p => p.handle !== currentProduct.handle);
      recentlyViewed.unshift(currentProduct);
      if (recentlyViewed.length > limit) recentlyViewed.length = limit; // Trim array to the exact limit
      
      localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify(recentlyViewed));
    {% endif %}

    // 2. Render the products (skipping the one currently being viewed)
    // FIX 3: Appended section.id to the grid ID so multiple instances of this section wouldn't conflict
    const grid = document.getElementById('recently-viewed-grid-{{ section.id }}');
    if (!grid) return;

    const productsToRender = recentlyViewed.filter(p => p.handle !== currentHandle).slice(0, limit);

    if (productsToRender.length > 0) {
      grid.innerHTML = productsToRender.map(product => `
        <div class="grid__item">
          <a href="${product.url}" style="text-decoration: none; color: inherit;">
            <img src="${product.image}" alt="${product.title}" style="max-width: 100%; height: auto; border-radius: 8px;">
            <h3 class="h5">${product.title}</h3>
            <p>${product.price}</p>
          </a>
        </div>
      `).join('');
    } else {
      // Hide the entire wrapper if empty, not just the grid's immediate parent
      grid.closest('.recently-viewed-section-wrapper').style.display = 'none';
    }
  });
</script>

{% schema %}
{
  "name": "Recently Viewed",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently Viewed Products"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "label": "Maximum products to show"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Desktop Settings"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Number of columns on desktop"
    },
    {
      "type": "header",
      "content": "Mobile Settings"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "Number of columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Recently Viewed"
    }
  ]
}
{% endschema %}